        <mxCell id="subtitulo" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;align=center;verticalAlign=middle;fontColor=#666666;fontFamily=Arial;" value="Solicitud, reserva, entrega y destino — balanceado con secuencia de roles y actividad" vertex="1">
          <mxGeometry x="170" y="64" width="1260" height="28" as="geometry" />
        </mxCell>
        <mxCell id="entrada" parent="1" style="swimlane;horizontal=1;startSize=52;whiteSpace=wrap;html=1;rounded=0;fillColor=#bfe3f2;swimlaneFillColor=#d9eef8;strokeColor=#6c8ebf;strokeWidth=2;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;" value="&lt;b&gt;&lt;u&gt;Entrada&lt;/u&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry x="40" y="140" width="480" height="570" as="geometry" />
        </mxCell>
        <mxCell id="comportamiento" parent="1" style="swimlane;horizontal=1;startSize=52;whiteSpace=wrap;html=1;rounded=0;fillColor=#f4c7c3;swimlaneFillColor=#f9dedb;strokeColor=#b85450;strokeWidth=2;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;" value="&lt;b&gt;&lt;u&gt;Comportamiento&lt;/u&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry x="560" y="115" width="480" height="620" as="geometry" />
        </mxCell>
        <mxCell id="salida" parent="1" style="swimlane;horizontal=1;startSize=52;whiteSpace=wrap;html=1;rounded=0;fillColor=#d8d0ed;swimlaneFillColor=#e9e4f5;strokeColor=#9673a6;strokeWidth=2;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;" value="&lt;b&gt;&lt;u&gt;Salida&lt;/u&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry x="1080" y="140" width="480" height="570" as="geometry" />
        </mxCell>
        <mxCell id="entrada-contenido" parent="1" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=13;fontFamily=Arial;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=10;" value="&lt;b&gt;E1.&lt;/b&gt; Necesidad transfusional: paciente receptor, componente y cantidad.&lt;br&gt;&lt;br&gt;&lt;b&gt;E2.&lt;/b&gt; Solicitud elegida y cantidad a reservar.&lt;br&gt;&lt;br&gt;&lt;b&gt;E3.&lt;/b&gt; Reserva activa y confirmación de entrega.&lt;br&gt;&lt;br&gt;&lt;b&gt;E4.&lt;/b&gt; Entrega y destino; motivo si Devuelta o Descartada.&lt;br&gt;&lt;br&gt;&lt;b&gt;E7.&lt;/b&gt; Reserva activa y motivo de cancelación.&lt;br&gt;&lt;br&gt;&lt;b&gt;E9.&lt;/b&gt; Destino de entrega registrado: transfundida, devuelta o descartada." vertex="1">
          <mxGeometry x="60" y="210" width="440" height="510" as="geometry" />
        </mxCell>
        <mxCell id="comportamiento-contenido" parent="1" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=13;fontFamily=Arial;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=10;" value="&lt;b&gt;CDUN-13 Registrar solicitud transfusional / C1.&lt;/b&gt; Registrar la solicitud.&lt;br&gt;&lt;br&gt;&lt;b&gt;CDUN-12 Gestionar inventario / C2.&lt;/b&gt; Consultar disponibilidad en «Reservas y entregas».&lt;br&gt;&lt;br&gt;&lt;b&gt;CDUN-14 Reservar y entregar unidad / C3.&lt;/b&gt; Validar unidad clasificada, Liberada, vigente y disponible; comprobar saldo.&lt;br&gt;&lt;br&gt;&lt;b&gt;CDUN-14 Reservar y entregar unidad / C4.&lt;/b&gt; Reservar unidades y asociarlas a la solicitud; admite atención parcial.&lt;br&gt;&lt;br&gt;&lt;b&gt;CDUN-14 Reservar y entregar unidad / C5.&lt;/b&gt; Confirmar una reserva activa y registrar la entrega.&lt;br&gt;&lt;br&gt;&lt;b&gt;CDUN-15 Registrar transfusión, devolución o descarte / C6.&lt;/b&gt; Registrar destino: Transfundida, Devuelta o Descartada.&lt;br&gt;&lt;br&gt;&lt;b&gt;C9.&lt;/b&gt; Cancelar manualmente una reserva activa con motivo.&lt;br&gt;&lt;br&gt;&lt;b&gt;C11.&lt;/b&gt; Generar automáticamente el comprobante de la entrega." vertex="1">
          <mxGeometry x="580" y="185" width="440" height="540" as="geometry" />
        </mxCell>
        <mxCell id="salida-contenido" parent="1" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=13;fontFamily=Arial;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=10;" value="&lt;b&gt;S1.&lt;/b&gt; Solicitud registrada y pendiente.&lt;br&gt;&lt;br&gt;&lt;b&gt;S2.&lt;/b&gt; Unidades disponibles y saldo visibles en «Reservas y entregas».&lt;br&gt;&lt;br&gt;&lt;b&gt;S3.&lt;/b&gt; Reserva activa; cantidades actualizadas.&lt;br&gt;&lt;br&gt;&lt;b&gt;S4.&lt;/b&gt; Entrega registrada; cantidades actualizadas.&lt;br&gt;&lt;br&gt;&lt;b&gt;S5.&lt;/b&gt; Destino guardado; devolución o descarte reabre saldo y conserva historial.&lt;br&gt;&lt;br&gt;&lt;b&gt;S8.&lt;/b&gt; Reserva cancelada; unidad Liberada y saldo actualizado.&lt;br&gt;&lt;br&gt;&lt;b&gt;S10.&lt;/b&gt; PDF de la entrega y su destino o comprobante pendiente de reintento." vertex="1">
          <mxGeometry x="1100" y="210" width="440" height="510" as="geometry" />
        </mxCell>
        <mxCell id="flujo-entrada" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=2;" value="" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="520" y="425" as="sourcePoint" />
            <mxPoint x="560" y="425" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="flujo-salida" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=2;" value="" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1040" y="425" as="sourcePoint" />
            <mxPoint x="1080" y="425" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="nota-pantallas" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;fontSize=12;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;" value="&lt;b&gt;Pantallas PN2:&lt;/b&gt; «Solicitudes transfusionales» → «Reservas y entregas» → «Destino de unidades».&lt;br&gt;&lt;b&gt;Fuera del flujo:&lt;/b&gt; «Consultas» es independiente. No hay pantalla de inventario ni campos de ubicación u observaciones. Una unidad Devuelta requiere reingreso autorizado y nueva clasificación y liberación por PN1 antes de volver a estar disponible." vertex="1">
          <mxGeometry x="60" y="750" width="1480" height="105" as="geometry" />
        </mxCell>
      </root>
