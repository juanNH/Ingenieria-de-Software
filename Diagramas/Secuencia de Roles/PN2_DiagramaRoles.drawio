          <mxGeometry x="780" y="130" width="40" height="80" as="geometry" />
        </mxCell>
        <mxCell id="actor-banco" parent="1" style="shape=umlActor;html=1;fillColor=#e1f5e0;strokeColor=#82b366;strokeWidth=2;" value="" vertex="1">
          <mxGeometry x="1320" y="130" width="40" height="80" as="geometry" />
        </mxCell>
        <mxCell id="label-profesional" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontFamily=Arial;align=center;verticalAlign=top;whiteSpace=wrap;" value="&lt;b&gt;Profesional solicitante&lt;/b&gt;" vertex="1">
          <mxGeometry x="100" y="235" width="320" height="38" as="geometry" />
        </mxCell>
        <mxCell id="label-autorizado" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontFamily=Arial;align=center;verticalAlign=top;whiteSpace=wrap;" value="&lt;b&gt;Operador autorizado&lt;/b&gt;" vertex="1">
          <mxGeometry x="640" y="235" width="320" height="38" as="geometry" />
        </mxCell>
        <mxCell id="label-banco" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontFamily=Arial;align=center;verticalAlign=top;whiteSpace=wrap;" value="&lt;b&gt;Operador del banco de sangre&lt;/b&gt;" vertex="1">
          <mxGeometry x="1180" y="235" width="320" height="38" as="geometry" />
        </mxCell>
        <mxCell id="tarea-profesional" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8f0;strokeColor=#d79b00;fontSize=13;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=10;" value="&lt;b&gt;Entrada E1&lt;/b&gt; — Necesidad transfusional: paciente receptor, componente y cantidad.&lt;br&gt;&lt;br&gt;&lt;b&gt;CDUN-13 / C1&lt;/b&gt; — Registra la solicitud en «Solicitudes transfusionales».&lt;br&gt;&lt;br&gt;&lt;b&gt;Salida S1&lt;/b&gt; — Solicitud registrada y pendiente." vertex="1">
          <mxGeometry x="65" y="300" width="430" height="300" as="geometry" />
        </mxCell>
        <mxCell id="tarea-autorizado" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffdf2;strokeColor=#d6b656;fontSize=13;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=10;" value="&lt;b&gt;Entrada E2&lt;/b&gt; — Solicitud elegida y cantidad a reservar.&lt;br&gt;&lt;br&gt;&lt;b&gt;CDUN-14 / C3–C4&lt;/b&gt; — Valida aptitud y saldo; registra reservas parciales en «Reservas y entregas».&lt;br&gt;&lt;br&gt;&lt;b&gt;CDUN-14 / C5&lt;/b&gt; — Confirma la reserva activa y registra la entrega.&lt;br&gt;&lt;br&gt;&lt;b&gt;E7 / C9&lt;/b&gt; — Puede cancelar manualmente una reserva activa con motivo." vertex="1">
          <mxGeometry x="585" y="300" width="430" height="420" as="geometry" />
        </mxCell>
        <mxCell id="tarea-banco" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2fbf1;strokeColor=#82b366;fontSize=13;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=10;" value="&lt;b&gt;CDUN-12 Gestionar inventario&lt;/b&gt; — El Operador del banco de sangre consulta disponibilidad desde «Reservas y entregas». Durante la reserva, el Operador autorizado ve allí las mismas unidades aptas; no hay pantalla independiente.&lt;br&gt;&lt;br&gt;&lt;b&gt;Entrada E4&lt;/b&gt; — Entrega y destino elegido: Transfundida, Devuelta o Descartada.&lt;br&gt;&lt;br&gt;&lt;b&gt;CDUN-15 / C6&lt;/b&gt; — Registra el destino en «Destino de unidades»; exige motivo para devolución o descarte.&lt;br&gt;&lt;br&gt;&lt;b&gt;Salida S5&lt;/b&gt; — Destino guardado y saldo actualizado." vertex="1">
          <mxGeometry x="1105" y="300" width="430" height="300" as="geometry" />
        </mxCell>
        <mxCell id="rel-profesional-autorizado-e1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;fontFamily=Arial;labelBackgroundColor=#ffffff;" value="Entrada E1: Necesidad transfusional" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="280" y="165" as="sourcePoint" />
            <mxPoint x="780" y="165" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rel-autorizado-profesional-s1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;fontFamily=Arial;labelBackgroundColor=#ffffff;" value="Salida S1: Solicitud registrada y pendiente" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="780" y="195" as="sourcePoint" />
            <mxPoint x="280" y="195" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rel-autorizado-banco-s4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;fontFamily=Arial;labelBackgroundColor=#ffffff;" value="Salida S4: Entrega registrada para indicar su destino" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="820" y="165" as="sourcePoint" />
            <mxPoint x="1320" y="165" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rel-banco-autorizado-e4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;fontFamily=Arial;labelBackgroundColor=#ffffff;" value="Entrada E4: Destino de la unidad entregada" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1320" y="195" as="sourcePoint" />
            <mxPoint x="820" y="195" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="reglas-pn2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;fontSize=12;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;" value="&lt;b&gt;Pantallas PN2&lt;/b&gt; — «Solicitudes transfusionales» → «Reservas y entregas» → «Destino de unidades». Las pestañas PN1 y PN2 se separan y despliegan sus pantallas al pasar el cursor.&lt;br&gt;&lt;br&gt;&lt;b&gt;Reglas&lt;/b&gt; — Atención parcial; se muestran cantidad requerida, reservada, entregada y saldo. La cancelación es manual y requiere motivo. Devolución y descarte reabren saldo y conservan historial. Una unidad Devuelta sigue indisponible hasta su reingreso autorizado a En revisión y nueva clasificación y liberación en PN1. «Consultas» es independiente." vertex="1">
          <mxGeometry x="65" y="770" width="1470" height="170" as="geometry" />
        </mxCell>
        <mxCell id="comprobante-pn2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" value="&lt;b&gt;E9 / C11 / S10&lt;/b&gt; — Al registrar el destino de una entrega, el sistema genera automáticamente su comprobante. Ante un fallo de archivo, conserva el pedido pendiente para reintento." vertex="1"><mxGeometry x="65" y="955" width="1470" height="75" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>