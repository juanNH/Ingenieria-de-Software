        <mxCell id="titulo" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=1;fontSize=22;align=center;verticalAlign=middle;fontFamily=Arial;" value="PN2 — Diagrama de roles: Solicitud, reserva, entrega y destino de unidades" vertex="1">
          <mxGeometry x="120" y="22" width="1360" height="44" as="geometry" />
        </mxCell>
        <mxCell id="subtitulo" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;align=center;verticalAlign=middle;fontColor=#666666;fontFamily=Arial;" value="Flujo principal PN2: tres pantallas; Consultas queda fuera del proceso" vertex="1">
          <mxGeometry x="180" y="68" width="1240" height="30" as="geometry" />
        </mxCell>
        <mxCell id="actor-profesional" parent="1" style="shape=umlActor;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" value="" vertex="1">
          <mxGeometry x="240" y="130" width="40" height="80" as="geometry" />
