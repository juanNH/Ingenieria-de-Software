        <mxCell id="comportamiento" parent="1" style="swimlane;horizontal=1;startSize=52;whiteSpace=wrap;html=1;rounded=0;fillColor=#f4c7c3;swimlaneFillColor=#f9dedb;strokeColor=#b85450;strokeWidth=2;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;" value="&lt;b&gt;&lt;u&gt;Comportamiento&lt;/u&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="560" width="450" x="590" y="130" as="geometry" />
        </mxCell>
        <mxCell id="comportamiento-contenido" parent="1" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=14;fontFamily=Arial;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=10;" value="&lt;b&gt;C1.&lt;/b&gt; Registrar donante y donación.&lt;br&gt;&lt;br&gt;&lt;b&gt;C2.&lt;/b&gt; Generar e identificar una o más unidades.&lt;br&gt;&lt;br&gt;&lt;b&gt;C3.&lt;/b&gt; Asignar a las unidades el estado &amp;quot;En revisión&amp;quot;.&lt;br&gt;&lt;br&gt;&lt;b&gt;C4.&lt;/b&gt; Cargar la clasificación de la unidad.&lt;br&gt;&lt;br&gt;&lt;b&gt;C5.&lt;/b&gt; Validar los datos de control.&lt;br&gt;&lt;br&gt;&lt;b&gt;C6.&lt;/b&gt; Revisar la información de la unidad.&lt;br&gt;&lt;br&gt;&lt;b&gt;C7.&lt;/b&gt; Definir estado operativo: liberar, bloquear o descartar la unidad.&lt;br&gt;&lt;br&gt;&lt;b&gt;C8.&lt;/b&gt; Generar automáticamente el comprobante al completar las decisiones." vertex="1">
          <mxGeometry height="490" width="410" x="610" y="200" as="geometry" />
