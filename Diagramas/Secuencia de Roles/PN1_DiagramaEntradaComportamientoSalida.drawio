        </mxCell>
        <mxCell id="entrada-contenido" parent="1" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=14;fontFamily=Arial;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=10;" value="&lt;b&gt;E1.&lt;/b&gt; Datos del donante y de la donación.&lt;br&gt;&lt;br&gt;&lt;b&gt;E2.&lt;/b&gt; Datos de clasificación.&lt;br&gt;&lt;br&gt;&lt;b&gt;E3.&lt;/b&gt; Acción de estado solicitada: liberar, bloquear o descartar.&lt;br&gt;&lt;br&gt;&lt;b&gt;E4.&lt;/b&gt; Decisiones registradas para todas las unidades de la donación." vertex="1">
