<mxCell id="seq-133" value="&lt;b&gt;Bloquear y validar&lt;/b&gt; · autorizar y verificar integridad. La copia debe pertenecer al componente y la revisión esperada debe coincidir." style="text;fontFamily=Arial;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#18304B;fontSize=15;spacing=0;fontSize=13;" vertex="1" parent="1"><mxGeometry x="542" y="1162" width="924" height="36" as="geometry"/></mxCell>
