<mxCell id="seq-136" value="&lt;b&gt;Actualizar la descripción&lt;/b&gt; · tomar descripcion de la copia elegida y registrar Auditoria RESTORE_FIELD con id_copia_origen en el JSON." style="text;fontFamily=Arial;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#18304B;fontSize=15;spacing=0;fontSize=13;" vertex="1" parent="1"><mxGeometry x="542" y="1204" width="924" height="36" as="geometry"/></mxCell>
