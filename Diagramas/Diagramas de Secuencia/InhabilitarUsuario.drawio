        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {\n  \&quot;theme\&quot;: \&quot;base\&quot;,\n  \&quot;themeVariables\&quot;: {\n    \&quot;fontFamily\&quot;: \&quot;Arial\&quot;,\n    \&quot;actorBorder\&quot;: \&quot;#333333\&quot;,\n    \&quot;actorBkg\&quot;: \&quot;#ffffff\&quot;,\n    \&quot;actorTextColor\&quot;: \&quot;#333333\&quot;,\n    \&quot;participantBorder\&quot;: \&quot;#999999\&quot;,\n    \&quot;participantBkg\&quot;: \&quot;#f8f8f8\&quot;,\n    \&quot;participantTextColor\&quot;: \&quot;#333333\&quot;,\n    \&quot;activationBorderColor\&quot;: \&quot;#6ea8fe\&quot;,\n    \&quot;activationBkgColor\&quot;: \&quot;#dbeafe\&quot;,\n    \&quot;signalColor\&quot;: \&quot;#444444\&quot;,\n    \&quot;signalTextColor\&quot;: \&quot;#333333\&quot;,\n    \&quot;labelBoxBkgColor\&quot;: \&quot;#ffffff\&quot;,\n    \&quot;labelBoxBorderColor\&quot;: \&quot;#ff9999\&quot;,\n    \&quot;loopTextColor\&quot;: \&quot;#cc0000\&quot;,\n    \&quot;noteBkgColor\&quot;: \&quot;#fff7cc\&quot;,\n    \&quot;noteBorderColor\&quot;: \&quot;#e0c15a\&quot;\n  }\n}}%%\n\nsequenceDiagram\n    actor Usuario\n    participant MainForm_380_jh as UI.MainForm_380_jh\n    participant UsuariosView_380_jh as UI.UsuariosView_380_jh\n    participant PermisosSistema_380_jh as Domain.PermisosSistema_380_jh\n    participant UsuarioApp as Application.UsuarioApplicationService_380_jh\n    participant UsuarioRepo as Repository.UsuarioRepository_380_jh\n    participant UsuarioDM as DAL.UsuarioDataMapper_380_jh\n    participant DBContext as DAL.DatabaseContext_380_jh\n    participant SQL as SQL Server\n    participant UsuarioDomain as Domain.Usuario_380_jh\n    participant DigitoSvc as Application.DigitoVerificadorApplicationService_380_jh\n    participant AuditoriaSvc as Application.AuditoriaApplicationService_380_jh\n\n    Usuario-&gt;&gt;MainForm_380_jh: Click en menú Usuarios\n    activate MainForm_380_jh\n    MainForm_380_jh-&gt;&gt;MainForm_380_jh: usuariosToolStripMenuItem_Click_380_jh()\n    MainForm_380_jh-&gt;&gt;MainForm_380_jh: ValidarPermiso_380_jh(UsuarioVer_380_jh)\n\n    alt [Tiene permiso]\n        MainForm_380_jh-&gt;&gt;UsuariosView_380_jh: new UsuariosView_380_jh()\n        activate UsuariosView_380_jh\n        MainForm_380_jh-&gt;&gt;MainForm_380_jh: ShowScreen_380_jh(UsuariosView_380_jh)\n        MainForm_380_jh--&gt;&gt;Usuario_380_jh: Pantalla Usuarios\n        deactivate MainForm_380_jh\n\n        UsuariosView_380_jh-&gt;&gt;UsuarioApp: Listar_380_jh()\n        activate UsuarioApp\n        UsuarioApp-&gt;&gt;UsuarioRepo: Listar_380_jh()\n        activate UsuarioRepo\n        UsuarioRepo-&gt;&gt;UsuarioDM: Listar_380_jh()\n        activate UsuarioDM\n        UsuarioDM-&gt;&gt;DBContext: Abrir_380_jh()\n        activate DBContext\n        DBContext-&gt;&gt;SQL: SELECT usuarios\n        activate SQL\n        SQL--&gt;&gt;DBContext: Usuarios\n        deactivate SQL\n        DBContext--&gt;&gt;UsuarioDM: DataTable\n        DBContext-&gt;&gt;DBContext: Cerrar_380_jh()\n        deactivate DBContext\n        UsuarioDM--&gt;&gt;UsuarioRepo: List&lt;Usuario_380_jh&gt;\n        deactivate UsuarioDM\n        UsuarioRepo--&gt;&gt;UsuarioApp: List&lt;Usuario_380_jh&gt;\n        deactivate UsuarioRepo\n        UsuarioApp--&gt;&gt;UsuariosView_380_jh: List&lt;Usuario_380_jh&gt;\n        deactivate UsuarioApp\n\n        UsuariosView_380_jh-&gt;&gt;UsuariosView_380_jh: CargarUsuarios_380_jh()\n\n        Usuario-&gt;&gt;UsuariosView_380_jh: Selecciona usuario en grilla\n        UsuariosView_380_jh-&gt;&gt;UsuariosView_380_jh: dgvUsuarios_SelectionChanged_380_jh()\n        UsuariosView_380_jh-&gt;&gt;UsuariosView_380_jh: _usuarioSeleccionado_380_jh = usuario\n        UsuariosView_380_jh-&gt;&gt;UsuariosView_380_jh: Cargar datos en formulario\n\n        UsuariosView_380_jh-&gt;&gt;PermisosSistema_380_jh: UsuarioInhabilitar_380_jh\n        activate PermisosSistema_380_jh\n        PermisosSistema_380_jh--&gt;&gt;UsuariosView_380_jh: \&quot;USUARIO_INHABILITAR\&quot;\n        deactivate PermisosSistema_380_jh\n\n        UsuariosView_380_jh-&gt;&gt;UsuariosView_380_jh: Validar permiso UsuarioInhabilitar_380_jh\n        UsuariosView_380_jh-&gt;&gt;UsuariosView_380_jh: Validar estado != INACTIVO\n\n        alt [Sin permiso o usuario ya INACTIVO]\n            UsuariosView_380_jh--&gt;&gt;Usuario_380_jh: Botón Inhabilitar_380_jh deshabilitado\n        else [Puede inhabilitar]\n            Usuario-&gt;&gt;UsuariosView_380_jh: Click en botón Inhabilitar_380_jh\n            UsuariosView_380_jh-&gt;&gt;UsuariosView_380_jh: btnInhabilitar_Click_380_jh()\n\n            alt [_usuarioSeleccionado_380_jh == null]\n                UsuariosView_380_jh--&gt;&gt;Usuario_380_jh: Selecciona un usuario para inhabilitar\n            else [_usuarioSeleccionado_380_jh != null]\n                UsuariosView_380_jh--&gt;&gt;Usuario_380_jh: Confirmar_380_jh inhabilitación\n\n                alt [Usuario_380_jh cancela]\n                    Usuario_380_jh--&gt;&gt;UsuariosView_380_jh: No\n                    UsuariosView_380_jh--&gt;&gt;Usuario_380_jh: Operación cancelada\n                else [Usuario_380_jh confirma]\n                    Usuario_380_jh--&gt;&gt;UsuariosView_380_jh: Sí\n\n                    UsuariosView_380_jh-&gt;&gt;UsuarioApp: InhabilitarUsuario_380_jh(_usuarioSeleccionado_380_jh)\n                    activate UsuarioApp\n\n                    UsuarioApp-&gt;&gt;UsuarioApp: Validar usuario != null &amp;&amp; Id_380_jh != 0\n\n                    alt [Usuario_380_jh inválido]\n                        UsuarioApp--&gt;&gt;UsuariosView_380_jh: false\n                        UsuariosView_380_jh--&gt;&gt;Usuario_380_jh: No se pudo inhabilitar el usuario\n                    else [Usuario_380_jh válido]\n                        UsuarioApp-&gt;&gt;UsuarioRepo: ObtenerPorId_380_jh(usuario.Id_380_jh)\n                        activate UsuarioRepo\n                        UsuarioRepo-&gt;&gt;UsuarioDM: ObtenerPorId_380_jh(id)\n                        activate UsuarioDM\n                        UsuarioDM-&gt;&gt;DBContext: Abrir_380_jh()\n                        activate DBContext\n                        DBContext-&gt;&gt;SQL: SELECT Usuario WHERE id_usuario = @id_usuario\n                        activate SQL\n                        SQL--&gt;&gt;DBContext: Usuario anterior\n                        deactivate SQL\n                        DBContext--&gt;&gt;UsuarioDM: DataTable\n                        DBContext-&gt;&gt;DBContext: Cerrar_380_jh()\n                        deactivate DBContext\n                        UsuarioDM--&gt;&gt;UsuarioRepo: Usuario anterior\n                        deactivate UsuarioDM\n                        UsuarioRepo--&gt;&gt;UsuarioApp: Usuario anterior\n                        deactivate UsuarioRepo\n\n                        UsuarioApp-&gt;&gt;UsuarioRepo: Inhabilitar_380_jh(usuario)\n                        activate UsuarioRepo\n                        UsuarioRepo-&gt;&gt;UsuarioRepo: Validar usuario != null &amp;&amp; Id_380_jh != 0\n                        UsuarioRepo-&gt;&gt;UsuarioDM: Borrar_380_jh(usuario)\n                        activate UsuarioDM\n\n                        Note over UsuarioRepo,UsuarioDM: Aunque se llama Borrar_380_jh,&lt;br/&gt;realiza una baja lógica\n\n                        UsuarioDM-&gt;&gt;DBContext: CrearParametro_380_jh(\&quot;@id_usuario\&quot;, usuario.Id_380_jh)\n                        UsuarioDM-&gt;&gt;DBContext: Abrir_380_jh()\n                        activate DBContext\n                        DBContext-&gt;&gt;SQL: UPDATE dbo.Usuario SET estado_usuario = &#39;INACTIVO&#39;\n                        activate SQL\n                        Note over SQL: WHERE id_usuario = @id_usuario\n                        SQL--&gt;&gt;DBContext: Filas afectadas\n                        deactivate SQL\n                        DBContext--&gt;&gt;UsuarioDM: ExecuteNonQuery()\n                        DBContext-&gt;&gt;DBContext: Cerrar_380_jh()\n                        deactivate DBContext\n\n                        UsuarioDM--&gt;&gt;UsuarioRepo: int filasAfectadas\n                        deactivate UsuarioDM\n                        UsuarioRepo--&gt;&gt;UsuarioApp: true/false\n                        deactivate UsuarioRepo\n\n                        alt [No se actualizó ninguna fila]\n                            UsuarioApp--&gt;&gt;UsuariosView_380_jh: false\n                            UsuariosView_380_jh--&gt;&gt;Usuario_380_jh: No se pudo inhabilitar el usuario\n                        else [Inhabilitación exitosa]\n                            UsuarioApp-&gt;&gt;DigitoSvc: RecalcularUsuarios_380_jh()\n                            activate DigitoSvc\n                            DigitoSvc--&gt;&gt;UsuarioApp: true/false\n                            deactivate DigitoSvc\n\n                            UsuarioApp-&gt;&gt;UsuarioRepo: ObtenerPorId_380_jh(usuario.Id_380_jh)\n                            activate UsuarioRepo\n                            UsuarioRepo-&gt;&gt;UsuarioDM: ObtenerPorId_380_jh(id)\n                            activate UsuarioDM\n                            UsuarioDM-&gt;&gt;DBContext: Abrir_380_jh()\n                            activate DBContext\n                            DBContext-&gt;&gt;SQL: SELECT Usuario actualizado\n                            activate SQL\n                            SQL--&gt;&gt;DBContext: Usuario posterior\n                            deactivate SQL\n                            DBContext--&gt;&gt;UsuarioDM: DataTable\n                            DBContext-&gt;&gt;DBContext: Cerrar_380_jh()\n                            deactivate DBContext\n                            UsuarioDM--&gt;&gt;UsuarioRepo: Usuario posterior\n                            deactivate UsuarioDM\n                            UsuarioRepo--&gt;&gt;UsuarioApp: Usuario posterior\n                            deactivate UsuarioRepo\n\n                            alt [Usuario anterior y posterior existen]\n                                UsuarioApp-&gt;&gt;UsuarioDomain: usuarioAnterior.CrearMemento_380_jh()\n                                activate UsuarioDomain\n                                UsuarioDomain--&gt;&gt;UsuarioApp: estadoAnterior\n                                deactivate UsuarioDomain\n\n                                UsuarioApp-&gt;&gt;UsuarioDomain: usuarioPosterior.CrearMemento_380_jh()\n                                activate UsuarioDomain\n                                UsuarioDomain--&gt;&gt;UsuarioApp: estadoPosterior\n                                deactivate UsuarioDomain\n\n                                UsuarioApp-&gt;&gt;AuditoriaSvc: RegistrarCambio_380_jh(estadoAnterior, estadoPosterior, \&quot;DISABLE\&quot;)\n                                activate AuditoriaSvc\n                                AuditoriaSvc--&gt;&gt;UsuarioApp: true/false\n                                deactivate AuditoriaSvc\n                            end\n\n                            UsuarioApp--&gt;&gt;UsuariosView_380_jh: true\n                            deactivate UsuarioApp\n\n                            UsuariosView_380_jh--&gt;&gt;Usuario_380_jh: Usuario_380_jh inhabilitado correctamente\n                            UsuariosView_380_jh-&gt;&gt;UsuariosView_380_jh: CargarUsuarios_380_jh()\n                            UsuariosView_380_jh-&gt;&gt;UsuariosView_380_jh: PrepararNuevoUsuario_380_jh()\n\n                            Note over SQL: Efecto posterior:&lt;br/&gt;el login filtra con estado_usuario = &#39;ACTIVO&#39;,&lt;br/&gt;por eso el usuario INACTIVO no puede iniciar sesión\n                        end\n                    end\n                end\n            end\n        end\n\n        deactivate UsuariosView_380_jh\n    else [Sin permiso]\n        MainForm_380_jh--&gt;&gt;Usuario_380_jh: Acceso denegado\n        deactivate MainForm_380_jh\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="wIlDSw7W2LBWPlbbdUxF-166">
