<mxfile host="app.diagrams.net">
  <diagram name="Página-1" id="dJi1M0-xEcyEZ3BhlwKQ">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1199.15" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\nconfig:\n  layout: elk\n---\nsequenceDiagram\n    autonumber\n    actor Usuario\n    participant Program_380_jh as UI.Program_380_jh\n    participant Login_380_jh as UI.Login_380_jh\n    participant UAS as Application.UsuarioApplicationService_380_jh\n    participant Pwd as Services.PlainTextPasswordService_380_jh\n    participant DV as Application.DigitoVerificadorApplicationService_380_jh\n    participant Repo as Repository.UsuarioRepository_380_jh\n    participant Mapper as DAL.UsuarioDataMapper_380_jh\n    participant PermRepo as Repository.PermisoRepository_380_jh\n    participant BitFactory as Domain.BitacoraFactory_380_jh\n    participant BitRepo as Repository.BitacoraRepository_380_jh\n    participant BitMapper as DAL.BitacoraDataMapper_380_jh\n    participant Sesion_380_jh as Domain.Sesion_380_jh\n    participant Lang as Services.LanguageManager_380_jh\n    participant Main as UI.MainForm_380_jh\n    participant DB as SQL Server\n    Usuario-&gt;&gt;Program_380_jh: Inicia la aplicación\n    Program_380_jh-&gt;&gt;Login_380_jh: ShowDialog()\n    Usuario-&gt;&gt;Login_380_jh: Ingresa usuario/email y contraseña\n    Usuario-&gt;&gt;Login_380_jh: Click en Login_380_jh\n    Login_380_jh-&gt;&gt;UAS: Login_380_jh(txtUser_380_jh.Text, txtPass_380_jh.Text)\n    alt Usuario_380_jh o contraseña vacíos\n        UAS--&gt;&gt;Login_380_jh: null\n        Login_380_jh--&gt;&gt;Usuario_380_jh: Usuario_380_jh, email o contraseña incorrectos\n    else Datos ingresados\n        UAS-&gt;&gt;Pwd: Hash_380_jh(password)\n        Pwd--&gt;&gt;UAS: passwordProtegida\n        UAS-&gt;&gt;DV: VerificarUsuarios_380_jh()\n        DV--&gt;&gt;UAS: integridadUsuariosValida\n        UAS-&gt;&gt;Repo: ObtenerPorCredenciales_380_jh(identificador, passwordProtegida)\n        Repo-&gt;&gt;Mapper: ObtenerPorCredenciales_380_jh(identificador, passwordProtegida)\n        Mapper-&gt;&gt;DB: SELECT Usuario_380_jh activo por usuario/email + password_hash\n        DB--&gt;&gt;Mapper: Usuario_380_jh o sin resultados\n        Mapper--&gt;&gt;Repo: Usuario_380_jh/null\n        Repo--&gt;&gt;UAS: Usuario_380_jh/null\n        alt Credenciales válidas\n            UAS-&gt;&gt;PermRepo: ListarAsignadosPorUsuario_380_jh(usuario.Id_380_jh)\n            PermRepo--&gt;&gt;UAS: ComponentesPermiso_380_jh\n            alt Integridad inválida y usuario no administrador\n                UAS--&gt;&gt;Login_380_jh: null\n                Login_380_jh-&gt;&gt;UAS: HayBloqueoDigitoVerificador_380_jh()\n                UAS-&gt;&gt;DV: VerificarUsuarios_380_jh()\n                DV--&gt;&gt;UAS: false\n                UAS--&gt;&gt;Login_380_jh: true\n                Login_380_jh--&gt;&gt;Usuario_380_jh: Inconsistencia de integridad\n            else Login_380_jh permitido\n                UAS-&gt;&gt;Repo: ReiniciarIntentosLoginFallidos_380_jh(usuario.Id_380_jh)\n                Repo-&gt;&gt;Mapper: ReiniciarIntentosLoginFallidos_380_jh(usuario.Id_380_jh)\n                Mapper-&gt;&gt;DB: UPDATE intentos_login_fallidos = 0\n                DB--&gt;&gt;Mapper: Filas afectadas\n                Mapper--&gt;&gt;Repo: resultado\n                Repo--&gt;&gt;UAS: true/false\n                UAS-&gt;&gt;DV: RecalcularUsuarioYDvv_380_jh(usuario.Id_380_jh)\n                UAS-&gt;&gt;BitFactory: LoginExitosoBitacoraFactory_380_jh.Crear_380_jh(...)\n                BitFactory--&gt;&gt;UAS: Evento LoginExitoso_380_jh\n                UAS-&gt;&gt;BitRepo: Registrar_380_jh(evento)\n                BitRepo-&gt;&gt;BitMapper: Insertar_380_jh(bitacora)\n                BitMapper-&gt;&gt;DB: EXEC sp_Bitacora_Registrar\n                DB--&gt;&gt;BitMapper: id_bitacora\n                BitMapper--&gt;&gt;BitRepo: id_bitacora\n                BitRepo--&gt;&gt;UAS: true\n                UAS--&gt;&gt;Login_380_jh: usuarioValidado\n                Login_380_jh-&gt;&gt;Sesion_380_jh: ObtenerInstancia_380_jh()\n                Sesion_380_jh--&gt;&gt;Login_380_jh: instancia\n                Login_380_jh-&gt;&gt;Sesion_380_jh: IniciarSesion_380_jh(usuarioValidado)\n                Login_380_jh-&gt;&gt;Lang: Initialize_380_jh(usuarioValidado)\n                Login_380_jh--&gt;&gt;Usuario_380_jh: Mensaje de bienvenida\n                Login_380_jh--&gt;&gt;Program_380_jh: DialogResult.OK\n                Program_380_jh-&gt;&gt;Main: Application.Run(new MainForm_380_jh())\n                Main-&gt;&gt;Sesion_380_jh: ObtenerInstancia_380_jh().ObtenerUsuario_380_jh()\n                Sesion_380_jh--&gt;&gt;Main: Usuario_380_jh autenticado\n                Main-&gt;&gt;Lang: Initialize_380_jh(usuario)\n                Main-&gt;&gt;Main: ConfigurarMenuPorPermisos_380_jh()\n                Main--&gt;&gt;Usuario_380_jh: Pantalla principal\n            end\n        else Credenciales inválidas\n            alt Integridad de usuarios válida\n                UAS-&gt;&gt;Repo: ObtenerActivoPorIdentificador_380_jh(identificador)\n                Repo-&gt;&gt;Mapper: ObtenerActivoPorIdentificador_380_jh(identificador)\n                Mapper-&gt;&gt;DB: SELECT Usuario_380_jh activo por usuario/email\n                DB--&gt;&gt;Mapper: Usuario_380_jh/null\n                Mapper--&gt;&gt;Repo: Usuario_380_jh/null\n                Repo--&gt;&gt;UAS: Usuario_380_jh/null\n                alt Usuario_380_jh activo existe\n                    UAS-&gt;&gt;Repo: RegistrarLoginFallidoPorIdentificador_380_jh(identificador)\n                    Repo-&gt;&gt;Mapper: RegistrarLoginFallidoPorIdentificador_380_jh(identificador)\n                    Mapper-&gt;&gt;DB: UPDATE intentos_login_fallidos + posible INACTIVO\n                    DB--&gt;&gt;Mapper: intentos_login_fallidos\n                    Mapper--&gt;&gt;Repo: intentosFallidos\n                    Repo--&gt;&gt;UAS: intentosFallidos\n                    UAS-&gt;&gt;DV: RecalcularUsuarioYDvv_380_jh(usuarioExistente.Id_380_jh)\n                    UAS-&gt;&gt;BitFactory: LoginFallidoBitacoraFactory_380_jh.Crear_380_jh(...)\n                    BitFactory--&gt;&gt;UAS: Evento LoginFallido_380_jh\n                    UAS-&gt;&gt;BitRepo: Registrar_380_jh(evento)\n                    BitRepo-&gt;&gt;BitMapper: Insertar_380_jh(bitacora)\n                    BitMapper-&gt;&gt;DB: EXEC sp_Bitacora_Registrar\n                    DB--&gt;&gt;BitMapper: id_bitacora\n                    BitMapper--&gt;&gt;BitRepo: id_bitacora\n                    BitRepo--&gt;&gt;UAS: true\n                end\n            end\n            UAS--&gt;&gt;Login_380_jh: null\n            Login_380_jh-&gt;&gt;UAS: EstaBloqueado_380_jh(txtUser_380_jh.Text)\n            UAS-&gt;&gt;Repo: EstaBloqueadoPorIdentificador_380_jh(identificador)\n            Repo-&gt;&gt;Mapper: EstaBloqueadoPorIdentificador_380_jh(identificador)\n            Mapper-&gt;&gt;DB: SELECT Usuario_380_jh con estado &lt;&gt; ACTIVO\n            DB--&gt;&gt;Mapper: resultado\n            Mapper--&gt;&gt;Repo: true/false\n            Repo--&gt;&gt;UAS: true/false\n            UAS--&gt;&gt;Login_380_jh: true/false\n            alt Usuario_380_jh bloqueado\n                Login_380_jh--&gt;&gt;Usuario_380_jh: El usuario está bloqueado\n            else No bloqueado\n                Login_380_jh-&gt;&gt;UAS: HayBloqueoDigitoVerificador_380_jh()\n                UAS-&gt;&gt;DV: VerificarUsuarios_380_jh()\n                DV--&gt;&gt;UAS: true/false\n                UAS--&gt;&gt;Login_380_jh: true/false\n                alt Hay bloqueo de integridad\n                    Login_380_jh--&gt;&gt;Usuario_380_jh: Inconsistencia de integridad\n                else Error_380_jh común\n                    Login_380_jh--&gt;&gt;Usuario_380_jh: Usuario_380_jh, email o contraseña incorrectos\n                end\n            end\n        end\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="aeVvulb9S0jTOAe1RU45-1270">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
            <mxGeometry height="5529" width="5160.55" as="geometry" />
          </mxCell>
