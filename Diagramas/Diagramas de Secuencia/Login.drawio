<mxfile host="app.diagrams.net">
  <diagram name="Página-1" id="dJi1M0-xEcyEZ3BhlwKQ">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\nconfig:\n  layout: elk\n---\nsequenceDiagram\n    autonumber\n    actor Usuario\n    participant Program as UI.Program\n    participant Login as UI.Login\n    participant UAS as Application.UsuarioApplicationService\n    participant Pwd as Services.PlainTextPasswordService\n    participant DV as Application.DigitoVerificadorApplicationService\n    participant Repo as Repository.UsuarioRepository\n    participant Mapper as DAL.UsuarioDataMapper\n    participant PermRepo as Repository.PermisoRepository\n    participant BitFactory as Domain.BitacoraFactory\n    participant BitRepo as Repository.BitacoraRepository\n    participant BitMapper as DAL.BitacoraDataMapper\n    participant Sesion as Domain.Sesion\n    participant Lang as Services.LanguageManager\n    participant Main as UI.MainForm\n    participant DB as SQL Server\n    Usuario-&gt;&gt;Program: Inicia la aplicación\n    Program-&gt;&gt;Login: ShowDialog()\n    Usuario-&gt;&gt;Login: Ingresa usuario/email y contraseña\n    Usuario-&gt;&gt;Login: Click en Login\n    Login-&gt;&gt;UAS: Login(txtUser.Text, txtPass.Text)\n    alt Usuario o contraseña vacíos\n        UAS--&gt;&gt;Login: null\n        Login--&gt;&gt;Usuario: Usuario, email o contraseña incorrectos\n    else Datos ingresados\n        UAS-&gt;&gt;Pwd: Hash(password)\n        Pwd--&gt;&gt;UAS: passwordProtegida\n        UAS-&gt;&gt;DV: VerificarUsuarios()\n        DV--&gt;&gt;UAS: integridadUsuariosValida\n        UAS-&gt;&gt;Repo: ObtenerPorCredenciales(identificador, passwordProtegida)\n        Repo-&gt;&gt;Mapper: ObtenerPorCredenciales(identificador, passwordProtegida)\n        Mapper-&gt;&gt;DB: SELECT Usuario activo por usuario/email + password_hash\n        DB--&gt;&gt;Mapper: Usuario o sin resultados\n        Mapper--&gt;&gt;Repo: Usuario/null\n        Repo--&gt;&gt;UAS: Usuario/null\n        alt Credenciales válidas\n            UAS-&gt;&gt;PermRepo: ListarAsignadosPorUsuario(usuario.Id)\n            PermRepo--&gt;&gt;UAS: ComponentesPermiso\n            alt Integridad inválida y usuario no administrador\n                UAS--&gt;&gt;Login: null\n                Login-&gt;&gt;UAS: HayBloqueoDigitoVerificador()\n                UAS-&gt;&gt;DV: VerificarUsuarios()\n                DV--&gt;&gt;UAS: false\n                UAS--&gt;&gt;Login: true\n                Login--&gt;&gt;Usuario: Inconsistencia de integridad\n            else Login permitido\n                UAS-&gt;&gt;Repo: ReiniciarIntentosLoginFallidos(usuario.Id)\n                Repo-&gt;&gt;Mapper: ReiniciarIntentosLoginFallidos(usuario.Id)\n                Mapper-&gt;&gt;DB: UPDATE intentos_login_fallidos = 0\n                DB--&gt;&gt;Mapper: Filas afectadas\n                Mapper--&gt;&gt;Repo: resultado\n                Repo--&gt;&gt;UAS: true/false\n                UAS-&gt;&gt;DV: RecalcularUsuarioYDvv(usuario.Id)\n                UAS-&gt;&gt;BitFactory: LoginExitosoBitacoraFactory.Crear(...)\n                BitFactory--&gt;&gt;UAS: Evento LoginExitoso\n                UAS-&gt;&gt;BitRepo: Registrar(evento)\n                BitRepo-&gt;&gt;BitMapper: Insertar(bitacora)\n                BitMapper-&gt;&gt;DB: EXEC sp_Bitacora_Registrar\n                DB--&gt;&gt;BitMapper: id_bitacora\n                BitMapper--&gt;&gt;BitRepo: id_bitacora\n                BitRepo--&gt;&gt;UAS: true\n                UAS--&gt;&gt;Login: usuarioValidado\n                Login-&gt;&gt;Sesion: ObtenerInstancia()\n                Sesion--&gt;&gt;Login: instancia\n                Login-&gt;&gt;Sesion: IniciarSesion(usuarioValidado)\n                Login-&gt;&gt;Lang: Initialize(usuarioValidado)\n                Login--&gt;&gt;Usuario: Mensaje de bienvenida\n                Login--&gt;&gt;Program: DialogResult.OK\n                Program-&gt;&gt;Main: Application.Run(new MainForm())\n                Main-&gt;&gt;Sesion: ObtenerInstancia().ObtenerUsuario()\n                Sesion--&gt;&gt;Main: Usuario autenticado\n                Main-&gt;&gt;Lang: Initialize(usuario)\n                Main-&gt;&gt;Main: ConfigurarMenuPorPermisos()\n                Main--&gt;&gt;Usuario: Pantalla principal\n            end\n        else Credenciales inválidas\n            alt Integridad de usuarios válida\n                UAS-&gt;&gt;Repo: ObtenerActivoPorIdentificador(identificador)\n                Repo-&gt;&gt;Mapper: ObtenerActivoPorIdentificador(identificador)\n                Mapper-&gt;&gt;DB: SELECT Usuario activo por usuario/email\n                DB--&gt;&gt;Mapper: Usuario/null\n                Mapper--&gt;&gt;Repo: Usuario/null\n                Repo--&gt;&gt;UAS: Usuario/null\n                alt Usuario activo existe\n                    UAS-&gt;&gt;Repo: RegistrarLoginFallidoPorIdentificador(identificador)\n                    Repo-&gt;&gt;Mapper: RegistrarLoginFallidoPorIdentificador(identificador)\n                    Mapper-&gt;&gt;DB: UPDATE intentos_login_fallidos + posible INACTIVO\n                    DB--&gt;&gt;Mapper: intentos_login_fallidos\n                    Mapper--&gt;&gt;Repo: intentosFallidos\n                    Repo--&gt;&gt;UAS: intentosFallidos\n                    UAS-&gt;&gt;DV: RecalcularUsuarioYDvv(usuarioExistente.Id)\n                    UAS-&gt;&gt;BitFactory: LoginFallidoBitacoraFactory.Crear(...)\n                    BitFactory--&gt;&gt;UAS: Evento LoginFallido\n                    UAS-&gt;&gt;BitRepo: Registrar(evento)\n                    BitRepo-&gt;&gt;BitMapper: Insertar(bitacora)\n                    BitMapper-&gt;&gt;DB: EXEC sp_Bitacora_Registrar\n                    DB--&gt;&gt;BitMapper: id_bitacora\n                    BitMapper--&gt;&gt;BitRepo: id_bitacora\n                    BitRepo--&gt;&gt;UAS: true\n                end\n            end\n            UAS--&gt;&gt;Login: null\n            Login-&gt;&gt;UAS: EstaBloqueado(txtUser.Text)\n            UAS-&gt;&gt;Repo: EstaBloqueadoPorIdentificador(identificador)\n            Repo-&gt;&gt;Mapper: EstaBloqueadoPorIdentificador(identificador)\n            Mapper-&gt;&gt;DB: SELECT Usuario con estado &lt;&gt; ACTIVO\n            DB--&gt;&gt;Mapper: resultado\n            Mapper--&gt;&gt;Repo: true/false\n            Repo--&gt;&gt;UAS: true/false\n            UAS--&gt;&gt;Login: true/false\n            alt Usuario bloqueado\n                Login--&gt;&gt;Usuario: El usuario está bloqueado\n            else No bloqueado\n                Login-&gt;&gt;UAS: HayBloqueoDigitoVerificador()\n                UAS-&gt;&gt;DV: VerificarUsuarios()\n                DV--&gt;&gt;UAS: true/false\n                UAS--&gt;&gt;Login: true/false\n                alt Hay bloqueo de integridad\n                    Login--&gt;&gt;Usuario: Inconsistencia de integridad\n                else Error común\n                    Login--&gt;&gt;Usuario: Usuario, email o contraseña incorrectos\n                end\n            end\n        end\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="aeVvulb9S0jTOAe1RU45-1270">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
            <mxGeometry height="5529" width="3559" as="geometry" />
          </mxCell>
        </UserObject>
