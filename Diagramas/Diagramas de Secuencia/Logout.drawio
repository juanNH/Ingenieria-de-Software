        </mxCell>
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\nconfig:\n  layout: elk\n---\nsequenceDiagram\n    actor Usuario\n    participant MainForm_380_jh as UI.MainForm_380_jh\n    participant UsuarioApp as Application.UsuarioApplicationService_380_jh\n    participant DigitoApp as Application.DigitoVerificadorApplicationService_380_jh\n    participant Sesion_380_jh as Domain.Sesion_380_jh\n    participant LanguageManager_380_jh as Services.LanguageManager_380_jh\n    participant Program_380_jh as UI.Program_380_jh\n    participant Login_380_jh as UI.Login_380_jh\n\n    Usuario-&gt;&gt;MainForm_380_jh: Click en \&quot;Cerrar_380_jh sesión\&quot;\n\n    activate MainForm_380_jh\n    MainForm_380_jh-&gt;&gt;UsuarioApp: RecalcularDigitosVerificadoresUsuarios_380_jh()\n\n    activate UsuarioApp\n    UsuarioApp-&gt;&gt;DigitoApp: RecalcularUsuarios_380_jh()\n\n    activate DigitoApp\n    DigitoApp--&gt;&gt;UsuarioApp: resultado\n    deactivate DigitoApp\n\n    UsuarioApp--&gt;&gt;MainForm_380_jh: true/false\n    deactivate UsuarioApp\n\n    MainForm_380_jh-&gt;&gt;Sesion_380_jh: ObtenerInstancia_380_jh()\n\n    activate Sesion_380_jh\n    Sesion_380_jh--&gt;&gt;MainForm_380_jh: instancia\n    deactivate Sesion_380_jh\n\n    MainForm_380_jh-&gt;&gt;Sesion_380_jh: Logout_380_jh()\n\n    activate Sesion_380_jh\n    Sesion_380_jh-&gt;&gt;Sesion_380_jh: _usuario_380_jh = null\n    Sesion_380_jh-&gt;&gt;Sesion_380_jh: _fechaInicio_380_jh = DateTime.MinValue\n    Sesion_380_jh--&gt;&gt;MainForm_380_jh: sesión cerrada\n    deactivate Sesion_380_jh\n\n    MainForm_380_jh-&gt;&gt;MainForm_380_jh: DialogResult = DialogResult.Retry\n    MainForm_380_jh-&gt;&gt;MainForm_380_jh: Close()\n\n    MainForm_380_jh-&gt;&gt;LanguageManager_380_jh: Detach_380_jh(this)\n\n    activate LanguageManager_380_jh\n    LanguageManager_380_jh--&gt;&gt;MainForm_380_jh: observador removido\n    deactivate LanguageManager_380_jh\n\n    deactivate MainForm_380_jh\n\n    MainForm_380_jh--&gt;&gt;Program_380_jh: MainForm_380_jh cerrado con DialogResult.Retry\n\n    activate Program_380_jh\n    Program_380_jh-&gt;&gt;Program_380_jh: mostrarLogin = mainForm.DialogResult == DialogResult.Retry\n\n    alt DialogResult.Retry\n        Program_380_jh-&gt;&gt;Login_380_jh: new Login_380_jh()\n        activate Login_380_jh\n        Program_380_jh-&gt;&gt;Login_380_jh: ShowDialog()\n        Login_380_jh--&gt;&gt;Usuario_380_jh: Pantalla de login\n        deactivate Login_380_jh\n    else Cierre normal\n        Program_380_jh-&gt;&gt;Program_380_jh: Finalizar aplicación\n    end\n\n    deactivate Program_380_jh&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="J0Gs5C-lzx8xjB_wLvxL-645">
