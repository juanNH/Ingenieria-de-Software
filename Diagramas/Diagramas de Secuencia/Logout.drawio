        <mxCell id="J0Gs5C-lzx8xjB_wLvxL-555" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;font style=&quot;font-size: 80px;&quot;&gt;&lt;b&gt;LOGOUT&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="970" x="840" y="1830" as="geometry" />
        </mxCell>
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\nconfig:\n  layout: elk\n---\nsequenceDiagram\n    actor Usuario\n    participant MainForm as UI.MainForm\n    participant UsuarioApp as Application.UsuarioApplicationService\n    participant DigitoApp as Application.DigitoVerificadorApplicationService\n    participant Sesion as Domain.Sesion\n    participant LanguageManager as Services.LanguageManager\n    participant Program as UI.Program\n    participant Login as UI.Login\n\n    Usuario-&gt;&gt;MainForm: Click en \&quot;Cerrar sesión\&quot;\n\n    activate MainForm\n    MainForm-&gt;&gt;UsuarioApp: RecalcularDigitosVerificadoresUsuarios()\n\n    activate UsuarioApp\n    UsuarioApp-&gt;&gt;DigitoApp: RecalcularUsuarios()\n\n    activate DigitoApp\n    DigitoApp--&gt;&gt;UsuarioApp: resultado\n    deactivate DigitoApp\n\n    UsuarioApp--&gt;&gt;MainForm: true/false\n    deactivate UsuarioApp\n\n    MainForm-&gt;&gt;Sesion: ObtenerInstancia()\n\n    activate Sesion\n    Sesion--&gt;&gt;MainForm: instancia\n    deactivate Sesion\n\n    MainForm-&gt;&gt;Sesion: Logout()\n\n    activate Sesion\n    Sesion-&gt;&gt;Sesion: _usuario = null\n    Sesion-&gt;&gt;Sesion: _fechaInicio = DateTime.MinValue\n    Sesion--&gt;&gt;MainForm: sesión cerrada\n    deactivate Sesion\n\n    MainForm-&gt;&gt;MainForm: DialogResult = DialogResult.Retry\n    MainForm-&gt;&gt;MainForm: Close()\n\n    MainForm-&gt;&gt;LanguageManager: Detach(this)\n\n    activate LanguageManager\n    LanguageManager--&gt;&gt;MainForm: observador removido\n    deactivate LanguageManager\n\n    deactivate MainForm\n\n    MainForm--&gt;&gt;Program: MainForm cerrado con DialogResult.Retry\n\n    activate Program\n    Program-&gt;&gt;Program: mostrarLogin = mainForm.DialogResult == DialogResult.Retry\n\n    alt DialogResult.Retry\n        Program-&gt;&gt;Login: new Login()\n        activate Login\n        Program-&gt;&gt;Login: ShowDialog()\n        Login--&gt;&gt;Usuario: Pantalla de login\n        deactivate Login\n    else Cierre normal\n        Program-&gt;&gt;Program: Finalizar aplicación\n    end\n\n    deactivate Program&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="J0Gs5C-lzx8xjB_wLvxL-645">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
