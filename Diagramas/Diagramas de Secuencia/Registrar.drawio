        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\n%%{init: {&#39;sequence&#39;: {&#39;mirrorActors&#39;: false}}}%%\nsequenceDiagram\n    actor Usuario\n    participant Login_380_jh as UI.Login_380_jh\n    participant Registro_380_jh as UI.Registro_380_jh\n    participant UsuarioApp as Application.UsuarioApplicationService_380_jh\n    participant PasswordService as Services.PlainTextPasswordService_380_jh\n    participant UsuarioRepo as Repository.UsuarioRepository_380_jh\n    participant UsuarioDataMapper_380_jh as DAL.UsuarioDataMapper_380_jh\n    participant SQLServer as SQL.Server\n    participant DigitoApp as Application.DigitoVerificadorApplicationService_380_jh\n    participant DigitoRepo as Repository.DigitoVerificadorRepository_380_jh\n    participant DigitoDataMapper as DAL.DigitoVerificadorDataMapper_380_jh\n    participant UsuarioDomain as Domain.Usuario_380_jh\n    participant AuditoriaApp as Application.AuditoriaApplicationService_380_jh\n    participant AuditoriaRepo as Repository.AuditoriaRepository_380_jh\n    participant AuditoriaDataMapper_380_jh as DAL.AuditoriaDataMapper_380_jh\n    participant BitacoraFactory_380_jh as Domain.BitacoraFactory_380_jh\n    participant BitacoraRepo as Repository.BitacoraRepository_380_jh\n    participant BitacoraDataMapper_380_jh as DAL.BitacoraDataMapper_380_jh\n\n    Usuario-&gt;&gt;Login_380_jh: Click en Registrarse\n    Login_380_jh-&gt;&gt;Registro_380_jh: new Registro_380_jh(_usuarioService_380_jh)\n    Login_380_jh-&gt;&gt;Registro_380_jh: ShowDialog(this)\n\n    Usuario-&gt;&gt;Registro_380_jh: Completa datos del formulario\n    Usuario-&gt;&gt;Registro_380_jh: Click en Crear cuenta\n    Registro_380_jh-&gt;&gt;Registro_380_jh: btnCrearCuenta_Click_380_jh(sender, e)\n\n    alt Campos incompletos\n        Registro_380_jh--&gt;&gt;Usuario_380_jh: Completa todos los campos para registrarte\n    else Campos completos\n        Registro_380_jh-&gt;&gt;UsuarioDomain: new Usuario_380_jh\n        UsuarioDomain--&gt;&gt;Registro_380_jh: nuevo\n\n        Registro_380_jh-&gt;&gt;UsuarioApp: CrearUsuario_380_jh(nuevo)\n\n        UsuarioApp-&gt;&gt;UsuarioApp: Validar datos obligatorios\n        UsuarioApp-&gt;&gt;UsuarioApp: Validar formato de email\n        UsuarioApp-&gt;&gt;UsuarioApp: Normalizar datos\n\n        UsuarioApp-&gt;&gt;PasswordService: Hash_380_jh(password)\n        PasswordService--&gt;&gt;UsuarioApp: passwordHash\n\n        UsuarioApp-&gt;&gt;UsuarioDomain: new Usuario_380_jh protegido (ComponentesPermiso_380_jh vacío; sin rol asignado)\n        UsuarioDomain--&gt;&gt;UsuarioApp: usuarioProtegido ACTIVO\n\n        UsuarioApp-&gt;&gt;UsuarioRepo: Crear_380_jh(usuarioProtegido)\n        UsuarioRepo-&gt;&gt;UsuarioDataMapper_380_jh: Insertar_380_jh(usuarioProtegido)\n\n        UsuarioDataMapper_380_jh-&gt;&gt;UsuarioDataMapper_380_jh: Crear_380_jh parametros SQL\n        UsuarioDataMapper_380_jh-&gt;&gt;SQLServer: sp_Usuario_Registrar\n\n        SQLServer-&gt;&gt;SQLServer: Validar nombre_usuario\n        SQLServer-&gt;&gt;SQLServer: Validar email\n        SQLServer-&gt;&gt;SQLServer: Buscar idioma default es-AR\n\n        alt Datos invalidos\n            UsuarioApp--&gt;&gt;Registro_380_jh: CodigoRegistroUsuario_380_jh.DatosInvalidos_380_jh\n            Registro_380_jh--&gt;&gt;Usuario_380_jh: Completa todos los campos para registrarte\n\n        else Email invalido\n            UsuarioApp--&gt;&gt;Registro_380_jh: CodigoRegistroUsuario_380_jh.EmailInvalido_380_jh\n            Registro_380_jh--&gt;&gt;Usuario_380_jh: Ingresa un email valido\n\n        else Usuario existente\n            SQLServer--&gt;&gt;UsuarioDataMapper_380_jh: USUARIO_EXISTENTE\n            UsuarioDataMapper_380_jh--&gt;&gt;UsuarioRepo: UsuarioExistente_380_jh\n            UsuarioRepo--&gt;&gt;UsuarioApp: UsuarioExistente_380_jh\n\n            UsuarioApp-&gt;&gt;BitacoraFactory_380_jh: Crear_380_jh evento registro fallido\n            BitacoraFactory_380_jh--&gt;&gt;UsuarioApp: evento\n            UsuarioApp-&gt;&gt;BitacoraRepo: Registrar_380_jh(evento)\n            BitacoraRepo-&gt;&gt;BitacoraDataMapper_380_jh: Insertar_380_jh(bitacora)\n            BitacoraDataMapper_380_jh-&gt;&gt;SQLServer: INSERT Bitacora\n            SQLServer--&gt;&gt;BitacoraDataMapper_380_jh: id_bitacora\n            BitacoraDataMapper_380_jh--&gt;&gt;BitacoraRepo: id_bitacora\n            BitacoraRepo--&gt;&gt;UsuarioApp: true\n\n            UsuarioApp--&gt;&gt;Registro_380_jh: CodigoRegistroUsuario_380_jh.UsuarioExistente_380_jh\n            Registro_380_jh--&gt;&gt;Usuario_380_jh: Ya existe un usuario con ese nombre\n\n        else Email existente\n            SQLServer--&gt;&gt;UsuarioDataMapper_380_jh: EMAIL_EXISTENTE\n            UsuarioDataMapper_380_jh--&gt;&gt;UsuarioRepo: EmailExistente_380_jh\n            UsuarioRepo--&gt;&gt;UsuarioApp: EmailExistente_380_jh\n\n            UsuarioApp-&gt;&gt;BitacoraFactory_380_jh: Crear_380_jh evento registro fallido\n            BitacoraFactory_380_jh--&gt;&gt;UsuarioApp: evento\n            UsuarioApp-&gt;&gt;BitacoraRepo: Registrar_380_jh(evento)\n            BitacoraRepo-&gt;&gt;BitacoraDataMapper_380_jh: Insertar_380_jh(bitacora)\n            BitacoraDataMapper_380_jh-&gt;&gt;SQLServer: INSERT Bitacora\n            SQLServer--&gt;&gt;BitacoraDataMapper_380_jh: id_bitacora\n            BitacoraDataMapper_380_jh--&gt;&gt;BitacoraRepo: id_bitacora\n            BitacoraRepo--&gt;&gt;UsuarioApp: true\n\n            UsuarioApp--&gt;&gt;Registro_380_jh: CodigoRegistroUsuario_380_jh.EmailExistente_380_jh\n            Registro_380_jh--&gt;&gt;Usuario_380_jh: Ya existe un usuario con ese email\n\n        else Idioma default inexistente\n            SQLServer--&gt;&gt;UsuarioDataMapper_380_jh: IDIOMA_DEFAULT_INEXISTENTE\n            UsuarioDataMapper_380_jh--&gt;&gt;UsuarioRepo: IdiomaDefaultInexistente_380_jh\n            UsuarioRepo--&gt;&gt;UsuarioApp: IdiomaDefaultInexistente_380_jh\n            UsuarioApp--&gt;&gt;Registro_380_jh: CodigoRegistroUsuario_380_jh.IdiomaDefaultInexistente_380_jh\n            Registro_380_jh--&gt;&gt;Usuario_380_jh: Falta el idioma default\n\n        else Registro correcto\n            SQLServer-&gt;&gt;SQLServer: BEGIN TRANSACTION\n            SQLServer-&gt;&gt;SQLServer: INSERT INTO dbo.Usuario\n            SQLServer-&gt;&gt;SQLServer: SCOPE_IDENTITY\n            SQLServer-&gt;&gt;SQLServer: COMMIT TRANSACTION\n            SQLServer--&gt;&gt;UsuarioDataMapper_380_jh: OK\n\n            UsuarioDataMapper_380_jh--&gt;&gt;UsuarioRepo: CodigoRegistroUsuario_380_jh.Creado_380_jh\n            UsuarioRepo--&gt;&gt;UsuarioApp: CodigoRegistroUsuario_380_jh.Creado_380_jh\n\n            UsuarioApp-&gt;&gt;DigitoApp: RecalcularUsuarios_380_jh()\n            DigitoApp-&gt;&gt;DigitoRepo: RecalcularUsuarios_380_jh()\n            DigitoRepo-&gt;&gt;DigitoDataMapper: RecalcularUsuarios_380_jh()\n            DigitoDataMapper-&gt;&gt;SQLServer: Recalcular DVH y DVV\n            SQLServer--&gt;&gt;DigitoDataMapper: DV calculado\n            DigitoDataMapper--&gt;&gt;DigitoRepo: true\n            DigitoRepo--&gt;&gt;DigitoApp: true\n            DigitoApp--&gt;&gt;UsuarioApp: true\n\n            UsuarioApp-&gt;&gt;UsuarioDomain: CrearMemento_380_jh()\n            UsuarioDomain--&gt;&gt;UsuarioApp: AuditoriaMemento_380_jh\n\n            UsuarioApp-&gt;&gt;AuditoriaApp: RegistrarAlta_380_jh(memento)\n            AuditoriaApp-&gt;&gt;AuditoriaRepo: Registrar_380_jh(auditoria)\n            AuditoriaRepo-&gt;&gt;AuditoriaDataMapper_380_jh: Insertar_380_jh(auditoria)\n            AuditoriaDataMapper_380_jh-&gt;&gt;SQLServer: INSERT Auditoria\n            SQLServer--&gt;&gt;AuditoriaDataMapper_380_jh: id_auditoria\n            AuditoriaDataMapper_380_jh--&gt;&gt;AuditoriaRepo: id_auditoria\n            AuditoriaRepo--&gt;&gt;AuditoriaApp: true\n            AuditoriaApp--&gt;&gt;UsuarioApp: true\n\n            UsuarioApp--&gt;&gt;Registro_380_jh: CodigoRegistroUsuario_380_jh.Creado_380_jh\n\n            Registro_380_jh-&gt;&gt;Registro_380_jh: UsuarioRegistrado_380_jh = nuevo.Username_380_jh\n            Registro_380_jh--&gt;&gt;Usuario_380_jh: Usuario registrado con exito\n            Registro_380_jh-&gt;&gt;Registro_380_jh: DialogResult = DialogResult.OK\n            Registro_380_jh-&gt;&gt;Registro_380_jh: Close()\n\n            Registro_380_jh--&gt;&gt;Login_380_jh: DialogResult.OK\n            Login_380_jh-&gt;&gt;Login_380_jh: txtUser_380_jh.Text = registro.UsuarioRegistrado_380_jh\n            Login_380_jh-&gt;&gt;Login_380_jh: txtPass_380_jh.Clear()\n            Login_380_jh-&gt;&gt;Login_380_jh: txtPass_380_jh.Focus()\n        end\n    end\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="mQW-zK-g5ZzS8QKeiOU5-1">
