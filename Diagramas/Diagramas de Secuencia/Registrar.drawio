<mxfile host="app.diagrams.net">
  <diagram name="Página-1" id="JP4MctfogicbBVwPzY-u">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\n%%{init: {&#39;sequence&#39;: {&#39;mirrorActors&#39;: false}}}%%\nsequenceDiagram\n    actor Usuario\n    participant Login as UI.Login\n    participant Registro as UI.Registro\n    participant UsuarioApp as Application.UsuarioApplicationService\n    participant PasswordService as Services.PlainTextPasswordService\n    participant UsuarioRepo as Repository.UsuarioRepository\n    participant UsuarioDataMapper as DAL.UsuarioDataMapper\n    participant SQLServer as SQL.Server\n    participant DigitoApp as Application.DigitoVerificadorApplicationService\n    participant DigitoRepo as Repository.DigitoVerificadorRepository\n    participant DigitoDataMapper as DAL.DigitoVerificadorDataMapper\n    participant UsuarioDomain as Domain.Usuario\n    participant AuditoriaApp as Application.AuditoriaApplicationService\n    participant AuditoriaRepo as Repository.AuditoriaRepository\n    participant AuditoriaDataMapper as DAL.AuditoriaDataMapper\n    participant BitacoraFactory as Domain.BitacoraFactory\n    participant BitacoraRepo as Repository.BitacoraRepository\n    participant BitacoraDataMapper as DAL.BitacoraDataMapper\n\n    Usuario-&gt;&gt;Login: Click en Registrarse\n    Login-&gt;&gt;Registro: new Registro(_usuarioService)\n    Login-&gt;&gt;Registro: ShowDialog(this)\n\n    Usuario-&gt;&gt;Registro: Completa datos del formulario\n    Usuario-&gt;&gt;Registro: Click en Crear cuenta\n    Registro-&gt;&gt;Registro: btnCrearCuenta_Click(sender, e)\n\n    alt Campos incompletos\n        Registro--&gt;&gt;Usuario: Completa todos los campos para registrarte\n    else Campos completos\n        Registro-&gt;&gt;UsuarioDomain: new Usuario\n        UsuarioDomain--&gt;&gt;Registro: nuevo\n\n        Registro-&gt;&gt;UsuarioApp: CrearUsuario(nuevo)\n\n        UsuarioApp-&gt;&gt;UsuarioApp: Validar datos obligatorios\n        UsuarioApp-&gt;&gt;UsuarioApp: Validar formato de email\n        UsuarioApp-&gt;&gt;UsuarioApp: Normalizar datos\n\n        UsuarioApp-&gt;&gt;PasswordService: Hash(password)\n        PasswordService--&gt;&gt;UsuarioApp: passwordHash\n\n        UsuarioApp-&gt;&gt;UsuarioDomain: new Usuario protegido\n        UsuarioDomain--&gt;&gt;UsuarioApp: usuarioProtegido ACTIVO\n\n        UsuarioApp-&gt;&gt;UsuarioRepo: Crear(usuarioProtegido)\n        UsuarioRepo-&gt;&gt;UsuarioDataMapper: Insertar(usuarioProtegido)\n\n        UsuarioDataMapper-&gt;&gt;UsuarioDataMapper: Crear parametros SQL\n        UsuarioDataMapper-&gt;&gt;SQLServer: sp_Usuario_Registrar\n\n        SQLServer-&gt;&gt;SQLServer: Validar nombre_usuario\n        SQLServer-&gt;&gt;SQLServer: Validar email\n        SQLServer-&gt;&gt;SQLServer: Buscar idioma default es-AR\n\n        alt Datos invalidos\n            UsuarioApp--&gt;&gt;Registro: CodigoRegistroUsuario.DatosInvalidos\n            Registro--&gt;&gt;Usuario: Completa todos los campos para registrarte\n\n        else Email invalido\n            UsuarioApp--&gt;&gt;Registro: CodigoRegistroUsuario.EmailInvalido\n            Registro--&gt;&gt;Usuario: Ingresa un email valido\n\n        else Usuario existente\n            SQLServer--&gt;&gt;UsuarioDataMapper: USUARIO_EXISTENTE\n            UsuarioDataMapper--&gt;&gt;UsuarioRepo: UsuarioExistente\n            UsuarioRepo--&gt;&gt;UsuarioApp: UsuarioExistente\n\n            UsuarioApp-&gt;&gt;BitacoraFactory: Crear evento registro fallido\n            BitacoraFactory--&gt;&gt;UsuarioApp: evento\n            UsuarioApp-&gt;&gt;BitacoraRepo: Registrar(evento)\n            BitacoraRepo-&gt;&gt;BitacoraDataMapper: Insertar(bitacora)\n            BitacoraDataMapper-&gt;&gt;SQLServer: INSERT Bitacora\n            SQLServer--&gt;&gt;BitacoraDataMapper: id_bitacora\n            BitacoraDataMapper--&gt;&gt;BitacoraRepo: id_bitacora\n            BitacoraRepo--&gt;&gt;UsuarioApp: true\n\n            UsuarioApp--&gt;&gt;Registro: CodigoRegistroUsuario.UsuarioExistente\n            Registro--&gt;&gt;Usuario: Ya existe un usuario con ese nombre\n\n        else Email existente\n            SQLServer--&gt;&gt;UsuarioDataMapper: EMAIL_EXISTENTE\n            UsuarioDataMapper--&gt;&gt;UsuarioRepo: EmailExistente\n            UsuarioRepo--&gt;&gt;UsuarioApp: EmailExistente\n\n            UsuarioApp-&gt;&gt;BitacoraFactory: Crear evento registro fallido\n            BitacoraFactory--&gt;&gt;UsuarioApp: evento\n            UsuarioApp-&gt;&gt;BitacoraRepo: Registrar(evento)\n            BitacoraRepo-&gt;&gt;BitacoraDataMapper: Insertar(bitacora)\n            BitacoraDataMapper-&gt;&gt;SQLServer: INSERT Bitacora\n            SQLServer--&gt;&gt;BitacoraDataMapper: id_bitacora\n            BitacoraDataMapper--&gt;&gt;BitacoraRepo: id_bitacora\n            BitacoraRepo--&gt;&gt;UsuarioApp: true\n\n            UsuarioApp--&gt;&gt;Registro: CodigoRegistroUsuario.EmailExistente\n            Registro--&gt;&gt;Usuario: Ya existe un usuario con ese email\n\n        else Idioma default inexistente\n            SQLServer--&gt;&gt;UsuarioDataMapper: IDIOMA_DEFAULT_INEXISTENTE\n            UsuarioDataMapper--&gt;&gt;UsuarioRepo: IdiomaDefaultInexistente\n            UsuarioRepo--&gt;&gt;UsuarioApp: IdiomaDefaultInexistente\n            UsuarioApp--&gt;&gt;Registro: CodigoRegistroUsuario.IdiomaDefaultInexistente\n            Registro--&gt;&gt;Usuario: Falta el idioma default\n\n        else Registro correcto\n            SQLServer-&gt;&gt;SQLServer: BEGIN TRANSACTION\n            SQLServer-&gt;&gt;SQLServer: INSERT INTO dbo.Usuario\n            SQLServer-&gt;&gt;SQLServer: SCOPE_IDENTITY\n            SQLServer-&gt;&gt;SQLServer: COMMIT TRANSACTION\n            SQLServer--&gt;&gt;UsuarioDataMapper: OK\n\n            UsuarioDataMapper--&gt;&gt;UsuarioRepo: CodigoRegistroUsuario.Creado\n            UsuarioRepo--&gt;&gt;UsuarioApp: CodigoRegistroUsuario.Creado\n\n            UsuarioApp-&gt;&gt;DigitoApp: RecalcularUsuarios()\n            DigitoApp-&gt;&gt;DigitoRepo: RecalcularUsuarios()\n            DigitoRepo-&gt;&gt;DigitoDataMapper: RecalcularUsuarios()\n            DigitoDataMapper-&gt;&gt;SQLServer: Recalcular DVH y DVV\n            SQLServer--&gt;&gt;DigitoDataMapper: DV calculado\n            DigitoDataMapper--&gt;&gt;DigitoRepo: true\n            DigitoRepo--&gt;&gt;DigitoApp: true\n            DigitoApp--&gt;&gt;UsuarioApp: true\n\n            UsuarioApp-&gt;&gt;UsuarioDomain: CrearMemento()\n            UsuarioDomain--&gt;&gt;UsuarioApp: AuditoriaMemento\n\n            UsuarioApp-&gt;&gt;AuditoriaApp: RegistrarAlta(memento)\n            AuditoriaApp-&gt;&gt;AuditoriaRepo: Registrar(auditoria)\n            AuditoriaRepo-&gt;&gt;AuditoriaDataMapper: Insertar(auditoria)\n            AuditoriaDataMapper-&gt;&gt;SQLServer: INSERT Auditoria\n            SQLServer--&gt;&gt;AuditoriaDataMapper: id_auditoria\n            AuditoriaDataMapper--&gt;&gt;AuditoriaRepo: id_auditoria\n            AuditoriaRepo--&gt;&gt;AuditoriaApp: true\n            AuditoriaApp--&gt;&gt;UsuarioApp: true\n\n            UsuarioApp--&gt;&gt;Registro: CodigoRegistroUsuario.Creado\n\n            Registro-&gt;&gt;Registro: UsuarioRegistrado = nuevo.Username\n            Registro--&gt;&gt;Usuario: Usuario registrado con exito\n            Registro-&gt;&gt;Registro: DialogResult = DialogResult.OK\n            Registro-&gt;&gt;Registro: Close()\n\n            Registro--&gt;&gt;Login: DialogResult.OK\n            Login-&gt;&gt;Login: txtUser.Text = registro.UsuarioRegistrado\n            Login-&gt;&gt;Login: txtPass.Clear()\n            Login-&gt;&gt;Login: txtPass.Focus()\n        end\n    end\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="mQW-zK-g5ZzS8QKeiOU5-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
